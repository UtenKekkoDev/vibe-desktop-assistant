#include <winver.h>
1 ICON "assets/app.ico"
1 VERSIONINFO
FILEVERSION VIBE_VERSION_NUM
PRODUCTVERSION VIBE_VERSION_NUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "Vibe Desktop Assistant"
   VALUE "FileVersion", VIBE_VERSION_STR
   VALUE "InternalName", "vibe-desktop-assistant"
   VALUE "OriginalFilename", "vibe-desktop-assistant.exe"
   VALUE "ProductName", "Vibe Desktop Assistant"
   VALUE "ProductVersion", VIBE_VERSION_STR
   VALUE "LegalCopyright", "MIT License"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
